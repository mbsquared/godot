-		float inv_effective_mass = (inWorldSpaceHingeAxis1.Dot(mInvI1_A) + inWorldSpaceHingeAxis2.Dot(mInvI2_B) * Square(inRatio));
+		// K^-1 = 1 / (J M^-1 J^T) = 1 / (a^T I1^-1 a + r^2 * b^T I2^-1 b) = 1 / (a^T I1^-1 a + r * b^T (r I2^-1 b))
+		float inv_effective_mass = (inWorldSpaceHingeAxis1.Dot(mInvI1_A) + inRatio * inWorldSpaceHingeAxis2.Dot(mRatio_InvI2_B));
 		if (inv_effective_mass == 0.0f)
 			Deactivate();
 		else
@@ -166,7 +170,7 @@ public:
 			if (ioBody1.IsDynamic())
 				ioBody1.AddRotationStep(lambda * mInvI1_A);
 			if (ioBody2.IsDynamic())
-				ioBody2.AddRotationStep(lambda * mInvI2_B);
+				ioBody2.AddRotationStep(lambda * mRatio_InvI2_B);
 			return true;
 		}
 
@@ -187,7 +191,7 @@ public:
 
 private:
 	Vec3						mInvI1_A;
-	Vec3						mInvI2_B;
+	Vec3						mRatio_InvI2_B;
 	float						mEffectiveMass = 0.0f;
 	float						mTotalLambda = 0.0f;
 };
