+++ b/thirdparty/jolt_physics/Jolt/Physics/Constraints/ConstraintPart/GearConstraintPart.h
@@ -52,7 +52,7 @@ class GearConstraintPart
 			// Euler velocity integration:
 			// v' = v + M^-1 P
 			ioBody1.GetMotionProperties()->AddAngularVelocityStep(inLambda * mInvI1_A);
-			ioBody2.GetMotionProperties()->AddAngularVelocityStep(inLambda * mInvI2_B);
+			ioBody2.GetMotionProperties()->AddAngularVelocityStep(inLambda * mRatio_InvI2_B);
 			return true;
 		}
 
@@ -74,11 +74,15 @@ public:
 		// Calculate: I1^-1 a
 		mInvI1_A = inBody1.GetMotionProperties()->MultiplyWorldSpaceInverseInertiaByVector(inBody1.GetRotation(), inWorldSpaceHingeAxis1);
 
-		// Calculate: I2^-1 b
-		mInvI2_B = inBody2.GetMotionProperties()->MultiplyWorldSpaceInverseInertiaByVector(inBody2.GetRotation(), inWorldSpaceHingeAxis2);
+		// CRUMB: calculate r I2^-1 b. Body 2's row of the Jacobian is r b^T, so the impulse P = J^T lambda
+		// moves body 2 by r lambda I2^-1 b, in the velocity step and the position step alike. Without the
+		// ratio here body 2 was pushed by lambda I2^-1 b whatever the ratio: a geared pair did not multiply
+		// torque, its momentum was not conserved, and a negative ratio fed back into a runaway. The rack
+		// and pinion part folds its ratio in the same way. For a ratio of 1 every product is unchanged.
+		mRatio_InvI2_B = inRatio * inBody2.GetMotionProperties()->MultiplyWorldSpaceInverseInertiaByVector(inBody2.GetRotation(), inWorldSpaceHingeAxis2);
 
